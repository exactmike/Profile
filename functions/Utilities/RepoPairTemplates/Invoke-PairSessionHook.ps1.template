#requires -Version 7.0
<#
.SYNOPSIS
    Session hook for a repo pair. Reminds the agent to keep its session log in the local companion repo.

.DESCRIPTION
    Generated by New-RepoPair into local_<repo>/tools/hooks/. Claude Code and Codex call it from their
    hook configuration. Both tools accept the same JSON: hookSpecificOutput.additionalContext goes to the
    model (plain stdout would too, but the user never sees it), systemMessage is shown to the user, and
    {"decision":"block","reason":...} from a Stop hook means "continue with this instruction".

    SessionStart: shows a one-line notice to the user, and gives the model the record-keeping reminder
                  and today's suggested session-log path.
    Stop:         if no session log was written today, asks the agent once to write one. The
                  stop_hook_active flag in the hook input prevents a loop.

.EXAMPLE
    pwsh -NoProfile -File Invoke-PairSessionHook.ps1 -Event SessionStart -Agent claude
#>
[CmdletBinding()]
param(
    # The hook event that called this script.
    [Parameter(Mandatory)]
    [ValidateSet('SessionStart', 'Stop')]
    [string]$Event,

    # The agent that called this script. Used in the suggested session-log file name.
    [ValidateSet('claude', 'codex', 'antigravity')]
    [string]$Agent = 'claude'
)

$localRoot = (Resolve-Path -Path (Join-Path -Path $PSScriptRoot -ChildPath '..' -AdditionalChildPath '..')).Path
$localName = Split-Path -Path $localRoot -Leaf
$sessionsDir = Join-Path -Path $localRoot -ChildPath 'sessions'
$today = Get-Date -Format 'yyyy-MM-dd'
$suggestedLog = "$localName/sessions/$today-$Agent-<topic>.md"

# Hook input arrives as JSON on stdin. It is empty when the script is run by hand.
$hookInput = $null
if ([Console]::IsInputRedirected) {
    $raw = [Console]::In.ReadToEnd()
    if (-not [string]::IsNullOrWhiteSpace($raw)) {
        try {
            $hookInput = $raw | ConvertFrom-Json -ErrorAction Stop
        } catch {
            $hookInput = $null
        }
    }
}

$todayLogs = @(
    Get-ChildItem -Path $sessionsDir -Filter '*.md' -File -ErrorAction SilentlyContinue |
        Where-Object -FilterScript { $_.LastWriteTime.Date -eq (Get-Date).Date }
)

switch ($Event) {
    'SessionStart' {
        $existing = if ($todayLogs.Count -gt 0) {
            "Session logs already written today: $(($todayLogs.Name) -join ', '). Append to the matching one."
        } else {
            'No session log exists for today yet.'
        }
        $context = @(
            "[repo pair] This project is a repo pair. Shared instructions: $localName/AGENTS.md."
            "[repo pair] Record session logs, decisions, plans, issues, PR drafts, and memory in $localName,"
            '            not in your tool''s own memory store.'
            "[repo pair] Session log for this session: $suggestedLog. $existing"
        ) -join [Environment]::NewLine
        [ordered]@{
            systemMessage      = "[repo pair] Instructions: $localName/AGENTS.md | session log: $suggestedLog"
            hookSpecificOutput = [ordered]@{
                hookEventName     = 'SessionStart'
                additionalContext = $context
            }
        } | ConvertTo-Json -Compress -Depth 5
    }
    'Stop' {
        $alreadyAsked = ($null -ne $hookInput) -and ($hookInput.stop_hook_active -eq $true)
        # Codex requires JSON on stdout from a Stop hook that exits 0, so "allow" is an empty object.
        if ($todayLogs.Count -eq 0 -and -not $alreadyAsked) {
            [ordered]@{
                decision = 'block'
                reason   = "Repo pair rule: before you stop, write or update the session log at $suggestedLog " +
                    "(template: $localName/templates/session.md). Record decisions in $localName/decisions/ " +
                    "and durable facts in $localName/memory/."
            } | ConvertTo-Json -Compress
        } else {
            '{}'
        }
    }
}
exit 0
